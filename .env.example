# Скопируйте этот файл в .env и впишите свои значения.
# Файл .env никогда не выкладывается в GitHub (он в .gitignore).

# Адрес сайта — нужен, чтобы банк знал, куда вернуть покупателя и куда слать уведомления
SITE_URL=https://baza-r-com.ru
PORT=3000

# --- Telegram-бот для заказов ---
# Токен выдаёт @BotFather после команды /newbot
TELEGRAM_BOT_TOKEN=
# id группы с заказами. Узнать: добавьте бота в группу, напишите там сообщение
# и откройте https://ваш-сайт/api/telegram-chat-id
TELEGRAM_CHAT_ID=
# Присылать заказ сразу при оформлении (true) или только после оплаты (false)
NOTIFY_UNPAID=true

# --- Интернет-эквайринг Т-Банка ---
# TerminalKey и пароль терминала: личный кабинет Т-Бизнес → Интернет-эквайринг → Магазины → Терминалы
# Для проверки сначала впишите ТЕСТОВЫЙ терминал (в названии есть DEMO), потом боевой.
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API=https://securepay.tinkoff.ru/v2

# --- Чеки (54-ФЗ) через «Чеки от Т-Кассы» ---
TBANK_RECEIPTS=true
# Система налогообложения: osn | usn_income (УСН доходы) | usn_income_outcome (УСН доходы−расходы) | patent
TAXATION=usn_income
# Ставка НДС в чеке: none (без НДС) | vat5 | vat7 | vat22 и т.д. — уточнить у бухгалтера
VAT=none
# Версия ФФД кассы: 1.2 или 1.05 — посмотреть в настройках кассы в кабинете Т-Бизнес
FFD_VERSION=1.2
